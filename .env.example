# Copy to .env and edit. .env is gitignored. Real environment variables and flags override it.
# All keys are described in README.md, section "Configure". pins.env holds the PINS Table settings.

# Data directory (contains db/gene_table.db and db/blastdb/). Inside Docker or the dev container it is /data.
GGTABLE_DATA=./data
# GGTABLE_ADDR=0.0.0.0:8080
# GGTABLE_STATIC=./static
# Gzip responses here; leave off behind nginx/Cloudflare, which compress for you.
# GGTABLE_GZIP=true

# Page header. Defaults: title "Gene Table v3", no subtitle.
GGTITLE=My Gene Table
GGSUBTITLE=

# Heatmap genomes (genome_id), comma-separated, in display order. Empty = all, in genome_info order.
GGSORTED=
